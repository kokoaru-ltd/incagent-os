# INCAGENT Engine environment template.
# Copy to .env for local use. Never commit real values.

PORT=3000

# Slack Socket Mode
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apotrail integration
APOTRAIL_BASE_URL=
APOTRAIL_SUPABASE_URL=
APOTRAIL_SUPABASE_ANON_KEY=
APOTRAIL_EMAIL=
APOTRAIL_PASSWORD=

# OpenAI controls whether src/index.js uses real Slack bot or mock mode.
# Leave empty for mock-only startup.
OPENAI_API_KEY=

# Optional business default for reception lead CLI.
BUSINESS_ID=inbound-agent
